{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/python/omega_resolver.py\" activations",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && python3 python/pretooluse_tripwires.py",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); case \"$f\" in *ISSUES.md) cd \"$CLAUDE_PROJECT_DIR\" && python3 python/issues_status.py --check >/dev/null 2>&1 || echo '{\"systemMessage\":\"\\u26a0 ISSUES.md gate FAILED \\u2014 run: python3 python/issues_status.py --check and fix the malformed entry.\"}';; esac; exit 0",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
